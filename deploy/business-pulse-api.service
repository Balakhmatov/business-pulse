[Unit]
Description=Business Pulse API (localhost only)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=business-pulse
WorkingDirectory=/opt/business-pulse/api
EnvironmentFile=/etc/business-pulse/bot.env
Environment=BP_API_PORT=3117
Environment=BP_DB_FILE=/var/lib/business-pulse/pulse.db
ExecStart=/usr/local/bin/node-business-pulse --experimental-sqlite /opt/business-pulse/api/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/business-pulse
PrivateTmp=true

[Install]
WantedBy=multi-user.target
